FROM rust:latest as builder

WORKDIR /app
COPY . .
RUN cargo build --release --example hot_cache_server

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/examples/hot_cache_server /usr/local/bin/blazecache

EXPOSE 6784

ENV NODE_ID=node1
ENV PORT=6784
ENV BLAZECACHE_MAX_MEMORY=134217728

CMD ["blazecache"]
